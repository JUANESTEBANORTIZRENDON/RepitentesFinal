@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Panel de Administración";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
            <div class="mb-5">
                <div class="bg-primary bg-opacity-10 d-inline-flex p-4 rounded-circle mb-4">
                    <i class="fas fa-lock fa-4x text-primary"></i>
                </div>
                <h1 class="display-5 fw-bold text-gradient text-primary mb-3">Panel de Administración</h1>
                <div class="lead text-muted mb-4">
                    <p class="mb-3">Bienvenido al centro de control de tu tienda virtual</p>
                    <div class="d-flex justify-content-center">
                        <div class="border-top border-primary border-2 w-25"></div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-5">
                <div class="card-body p-4 p-md-5">
                    <p class="fs-5 mb-4">
                        Esta área está diseñada exclusivamente para administradores del sistema.
                        Desde aquí podrás gestionar todos los aspectos críticos de tu tienda virtual.
                    </p>

                    <div class="row g-4 mt-3">
                        <div class="col-md-4">
                            <div class="p-3 border rounded bg-light">
                                <i class="fas fa-boxes text-primary mb-2 fs-4"></i>
                                <h5 class="h6 mb-2">Gestión de Productos</h5>
                                <p class="small text-muted mb-0">Administra tu catálogo completo</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded bg-light">
                                <i class="fas fa-users-cog text-primary mb-2 fs-4"></i>
                                <h5 class="h6 mb-2">Control de Usuarios</h5>
                                <p class="small text-muted mb-0">Gestiona clientes y permisos</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded bg-light">
                                <i class="fas fa-chart-line text-primary mb-2 fs-4"></i>
                                <h5 class="h6 mb-2">Reportes y Ventas</h5>
                                <p class="small text-muted mb-0">Analiza el desempeño comercial</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-primary bg-primary bg-opacity-10 border-0">
                <div class="d-flex">
                    <div class="flex-shrink-0 me-3">
                        <i class="fas fa-info-circle text-primary fs-4"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="alert-heading h6 mb-2">¿Necesitas ayuda?</h5>
                        <p class="small mb-0">Utiliza las opciones del menú lateral para acceder a todas las funcionalidades administrativas.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gradient {
        background: linear-gradient(to right, #0d6efd, #00b4ff);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }
</style>