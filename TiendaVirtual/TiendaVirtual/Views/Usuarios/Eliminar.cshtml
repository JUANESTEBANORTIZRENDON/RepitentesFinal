@model TiendaVirtual.Models.Usuario
@{
    ViewData["Title"] = "Eliminar Usuario";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container py-4">
    <div class="card border-danger border-2">
        <div class="card-header bg-danger text-white py-3">
            <h2 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i> Eliminar Usuario</h2>
        </div>
        <div class="card-body">
            <div class="alert alert-danger">
                <h5 class="alert-heading">¡Advertencia!</h5>
                <p class="mb-0">Esta acción eliminará permanentemente al usuario y no se podrá deshacer.</p>
            </div>

            <div class="mb-4">
                <h5 class="mb-3">Detalles del Usuario:</h5>
                <div class="row">
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Nombre:</strong> @Model.Nombre</p>
                        <p class="mb-1"><strong>Correo:</strong> @Model.Correo</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Rol:</strong> <span class="badge bg-secondary">@Model.IdRolNavigation?.Nombre</span></p>
                        <p class="mb-1"><strong>Estado:</strong> @(Model.Confirmado ? "Confirmado" : "No confirmado")</p>
                    </div>
                </div>
            </div>

            <form asp-action="Eliminar" class="text-center">
                <input type="hidden" asp-for="IdUsuario" />
                <button type="submit" class="btn btn-danger px-4 me-2">
                    <i class="fas fa-trash-alt me-1"></i> Confirmar Eliminación
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="fas fa-times me-1"></i> Cancelar
                </a>
            </form>
        </div>
    </div>
</div>