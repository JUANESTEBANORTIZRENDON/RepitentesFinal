@model List<TiendaVirtual.Models.Producto>
@{
    ViewData["Title"] = "Inicio";
    var usuario = User.Identity.IsAuthenticated ? User.Identity.Name : "Invitado";
}

<div class="hero-banner mb-5">
    <h1>Bienvenido, @usuario</h1>
    <p class="lead mt-3">Explora productos pensados para ti. Vive una experiencia de compra moderna, rápida y atractiva.</p>
    <a class="btn btn-lg btn-primary mt-4 px-4 py-2" asp-controller="Catalogo" asp-action="Index" style="background-color:#74ebd5; border:none;">
        Ver catálogo completo
    </a>
</div>

<!-- Sección de productos destacados -->
<div class="container mt-5">
    <h2 class="text-center mb-4">Productos Destacados</h2>
    <div class="row">
        @if (Model.Any())
        {
            @foreach (var producto in Model)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(producto.Imagen))
                        {
                            <img src="@producto.Imagen" class="card-img-top" alt="@producto.Nombre" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <span class="text-muted">Sin imagen</span>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@producto.Nombre</h5>
                            <p class="card-text text-muted">@producto.Marca</p>
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <span class="h5 text-success mb-0">$@producto.PrecioUnitario</span>
                                <form asp-controller="Carrito" asp-action="Agregar" method="post">
                                    <input type="hidden" name="idProducto" value="@producto.IdProducto" />
                                    <input type="hidden" name="cantidad" value="1" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-cart-plus"></i> Añadir
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <p>No hay productos disponibles en este momento.</p>
            </div>
        }
    </div>
    
    <div class="text-center mt-4 mb-5">
        <a asp-controller="Catalogo" asp-action="Index" class="btn btn-outline-primary">Ver todos los productos</a>
    </div>
</div>
