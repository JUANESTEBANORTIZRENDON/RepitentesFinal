@model TiendaVirtual.Models.Usuario
@{
    ViewData["Title"] = "Cambiar Contraseña";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container py-4">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white py-3">
            <h2 class="mb-0"><i class="fas fa-key me-2"></i> Cambiar Contraseña</h2>
        </div>
        <div class="card-body">
            <form asp-action="CambiarClave" method="post" class="row g-3">
                <input type="hidden" name="id" value="@Model.IdUsuario" />

                <div class="col-md-12">
                    <label for="nuevaClave" class="form-label fw-bold">Nueva Contraseña</label>
                    <div class="input-group">
                        <input type="password" class="form-control" name="nuevaClave" id="nuevaClave" required />
                        <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="col-12 mt-3">
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="fas fa-times me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fas fa-save me-1"></i> Actualizar Contraseña
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('togglePassword').addEventListener('click', function() {
            const passwordInput = document.getElementById('nuevaClave');
            const icon = this.querySelector('i');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        });
    </script>
}