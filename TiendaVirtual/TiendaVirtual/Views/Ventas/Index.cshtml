@model IEnumerable<TiendaVirtual.Models.Factura>
@{
    ViewData["Title"] = "Gestión de Ventas";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2 class="mb-4">Gestión de Ventas</h2>

@if (TempData["mensaje"] != null)
{
    <div class="alert alert-success">@TempData["mensaje"]</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Buscar Ventas</h5>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label for="busqueda" class="form-label">Buscar por cliente o ID factura</label>
                <input type="text" class="form-control" id="busqueda" name="busqueda" value="@ViewBag.Busqueda" placeholder="Nombre, correo o ID factura">
            </div>
            <div class="col-md-3">
                <label for="fechaDesde" class="form-label">Desde</label>
                <input type="date" class="form-control" id="fechaDesde" name="fechaDesde" value="@ViewBag.FechaDesde">
            </div>
            <div class="col-md-3">
                <label for="fechaHasta" class="form-label">Hasta</label>
                <input type="date" class="form-control" id="fechaHasta" name="fechaHasta" value="@ViewBag.FechaHasta">
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <div class="d-grid gap-2 w-100">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search"></i> Buscar
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="fas fa-sync-alt"></i> Limpiar
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Historial de Ventas</h5>
        <span class="badge bg-light text-dark">@Model.Count() resultados</span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID Factura</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th>Total</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var factura in Model)
                    {
                        <tr>
                            <td>@factura.IdFactura</td>
                            <td>
                                @if (factura.IdUsuarioNavigation != null)
                                {
                                    <a asp-action="HistorialUsuario" asp-route-id="@factura.IdUsuario">
                                        @factura.IdUsuarioNavigation.Nombre
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Usuario eliminado</span>
                                }
                            </td>
                            <td>@factura.Fecha?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-success">$@factura.Total?.ToString("N2")</td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="Detalles" asp-route-id="@factura.IdFactura" class="btn btn-info btn-sm">
                                        <i class="fas fa-info-circle"></i> Detalles
                                    </a>
                                    @if (!string.IsNullOrEmpty(factura.RutaPdf))
                                    {
                                        <a asp-action="DescargarFactura" asp-route-id="@factura.IdFactura" class="btn btn-secondary btn-sm">
                                            <i class="fas fa-file-pdf"></i> PDF
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay ventas registradas en el sistema.
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // Enlazar eventos para fechas
            $("#fechaDesde").change(function() {
                var fechaDesde = $(this).val();
                var fechaHasta = $("#fechaHasta").val();
                
                // Si la fecha desde es mayor que la fecha hasta, actualizar fecha hasta
                if (fechaDesde && fechaHasta && fechaDesde > fechaHasta) {
                    $("#fechaHasta").val(fechaDesde);
                }
            });
            
            $("#fechaHasta").change(function() {
                var fechaHasta = $(this).val();
                var fechaDesde = $("#fechaDesde").val();
                
                // Si la fecha hasta es menor que la fecha desde, actualizar fecha desde
                if (fechaDesde && fechaHasta && fechaHasta < fechaDesde) {
                    $("#fechaDesde").val(fechaHasta);
                }
            });

            // Aplicar datatable para mejora de usabilidad si hay más de 10 registros y no hay búsqueda activa
            var hasBusqueda = "@(!string.IsNullOrEmpty(ViewBag.Busqueda) || !string.IsNullOrEmpty(ViewBag.FechaDesde) || !string.IsNullOrEmpty(ViewBag.FechaHasta))" === "True";

            if ($('table tbody tr').length > 10 && !hasBusqueda) {
                $('table').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json"
                    },
                    "order": [[2, "desc"]] // Ordenar por fecha descendente
                });
            }
        });
    </script>
}
