@model List<TiendaVirtual.Models.Producto>

@{
    ViewData["Title"] = "Catálogo Premium";
    var categorias = ViewBag.Categorias as Dictionary<int, string>;
}

<!-- Mensajes de alerta -->
<div class="container mt-3">
    @if (TempData["mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
</div>

<!-- Hero del Catálogo -->
<section class="catalog-hero">
    <div class="container">
        <h1 class="catalog-title">Nuestra Colección</h1>
        <p class="catalog-subtitle">Descubre los secretos de belleza mejor guardados</p>
    </div>
</section>

<!-- Filtros Mejorados -->
<div class="container">
    <div class="catalog-filters-container">
        <form method="get" class="catalog-filters-form">
            <div class="filter-group">
                <i class="fas fa-search filter-icon"></i>
                <input type="text" name="busqueda" class="form-control filter-input"
                       placeholder="Buscar producto..." value="@ViewBag.Busqueda" />
            </div>

            <div class="filter-group">
                <i class="fas fa-sort filter-icon"></i>
                <select name="orden" class="form-select filter-select">
                    <option value="">Ordenar por</option>
                    <option value="precio_asc" selected="@(ViewBag.Orden == "precio_asc")">Precio: menor a mayor</option>
                    <option value="precio_desc" selected="@(ViewBag.Orden == "precio_desc")">Precio: mayor a menor</option>
                    <option value="stock_asc" selected="@(ViewBag.Orden == "stock_asc")">Stock: menor a mayor</option>
                    <option value="stock_desc" selected="@(ViewBag.Orden == "stock_desc")">Stock: mayor a menor</option>
                </select>
            </div>

            <button type="submit" class="filter-button">
                <i class="fas fa-check-circle me-2"></i>Aplicar
            </button>
        </form>
    </div>
</div>

<!-- Grid de Productos -->
<div class="product-grid">
    @foreach (var item in Model)
    {
        <div class="product-card">
            <div class="product-image-container">
                <img src="@item.Imagen" class="product-image" alt="@item.Nombre">
            </div>

            <div class="product-details">
                <h3 class="product-name">@item.Nombre</h3>
                <p class="product-meta"><strong>Ref:</strong> @item.CodigoProducto</p>
                <p class="product-meta"><strong>Disponibles:</strong> @item.Stock</p>
                <p class="product-price">$@item.PrecioUnitario</p>

                @if (item.Stock > 0)
                {
                    <button class="add-to-cart-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#productoModal"
                            data-id="@item.IdProducto"
                            data-nombre="@item.Nombre"
                            data-precio="@item.PrecioUnitario"
                            data-stock="@item.Stock"
                            data-imagen="@item.Imagen">
                        <i class="fas fa-shopping-bag"></i> Añadir
                    </button>
                }
                else
                {
                    <button class="add-to-cart-btn out-of-stock" disabled>
                        <i class="fas fa-times-circle"></i> Agotado
                    </button>
                }
            </div>
        </div>
    }
</div>

<!-- Modal Premium -->
<div class="modal fade" id="productoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="productoModalLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-controller="Carrito" asp-action="Agregar">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="modal-image-container">
                                <img id="modalProductoImagen" src="" class="img-fluid" alt="Producto">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <input type="hidden" name="IdProducto" id="modalIdProducto" />
                            <div class="modal-product-info">
                                <span class="modal-product-brand" id="modalProductoMarca"></span>
                                <h3 id="modalProductoNombre"></h3>
                                <div class="price-container">
                                    <span class="current-price">$<span id="modalProductoPrecio"></span></span>
                                </div>
                                <div class="stock-info">
                                    <i class="fas fa-check-circle"></i>
                                    <span id="modalProductoStock"></span> disponibles
                                </div>
                                <div class="quantity-selector">
                                    <label>Cantidad:</label>
                                    <div class="quantity-input">
                                        <button type="button" class="quantity-btn minus">-</button>
                                        <input type="number" name="Cantidad" id="modalCantidad" value="1" min="1">
                                        <button type="button" class="quantity-btn plus">+</button>
                                    </div>
                                </div>
                                <button type="submit" class="add-to-cart-modal">
                                    <i class="fas fa-shopping-bag me-2"></i>Añadir al carrito
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Script mejorado -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const modal = document.getElementById('productoModal');
        modal.addEventListener('show.bs.modal', function(event) {
            const button = event.relatedTarget;
            document.getElementById('modalProductoNombre').textContent = button.getAttribute('data-nombre');
            document.getElementById('modalProductoPrecio').textContent = button.getAttribute('data-precio');
            document.getElementById('modalProductoStock').textContent = button.getAttribute('data-stock');
            document.getElementById('modalProductoImagen').src = button.getAttribute('data-imagen');
            document.getElementById('modalIdProducto').value = button.getAttribute('data-id');

            // Actualizar máximo según stock disponible
            const stock = parseInt(button.getAttribute('data-stock'));
            document.getElementById('modalCantidad').max = stock;
        });

        // Contador de cantidad
        document.querySelectorAll('.quantity-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const input = this.parentElement.querySelector('input');
                let value = parseInt(input.value);

                if (this.classList.contains('minus') && value > 1) {
                    input.value = value - 1;
                } else if (this.classList.contains('plus') && value < parseInt(input.max)) {
                    input.value = value + 1;
                }
            });
        });
    });
</script>