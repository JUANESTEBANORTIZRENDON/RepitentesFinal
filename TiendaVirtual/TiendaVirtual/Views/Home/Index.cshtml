@{
    ViewData["Title"] = "Inicio";
    var usuario = User.Identity.IsAuthenticated ? User.Identity.Name : "Invitado";
}

<div class="hero-banner">
    <div class="hero-text">
        <h1>Bienvenido, @usuario</h1>
        <p class="lead mt-3">
            Explora productos pensados para ti. Vive una experiencia de compra moderna, rápida y atractiva.
        </p>
        <a class="btn btn-lg mt-4" asp-controller="Catálogo" asp-action="Index">
            Ver catálogo
        </a>
    </div>

    <div class="hero-image mt-4 mt-md-0">
        <img src="~/images/medical-care.svg" alt="Compra ilustrada" />
    </div>
</div>