@model TiendaVirtual.Models.Categorium
@{
    ViewData["Title"] = "Editar Categoría";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container py-4">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white py-3">
            <h2 class="mb-0"><i class="fas fa-edit me-2"></i> Editar Categoría</h2>
        </div>
        <div class="card-body">
            <form asp-action="Editar" method="post" class="row g-3">
                <input type="hidden" asp-for="IdCategoria" />
                <div class="col-md-12">
                    <label asp-for="Nombre" class="form-label fw-bold">Nombre de la categoría</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej. Electrónicos, Ropa, Hogar" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div class="col-12 mt-3">
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="fas fa-times me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fas fa-save me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}